# Installed wasigocvm toolchain. This tree is the only copy of that custom
# SDK — not a rebuildable byproduct of *.exe / *.a / *.o. Global artifact
# rules above do not apply to it.
!toolchain/bin/**
!toolchain/sysroot/**
!toolchain/lib/**
!toolchain/share/**
!toolchain/clang-resource-dir/**
!toolchain/wasigocvm-toolchain.json
!libc/**

# GPU/driver research artifacts — not part of the product
*.sys
/d3dkmt
/vidmm
/wddm
/woggpu.sys

# Scratch / one-off helpers (repo convention: leading underscore)
/_*
/FILL
toolchain/_*

